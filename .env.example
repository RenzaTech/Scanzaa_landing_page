# Optional override: Compose uses its isolated local Postgres by default.
# For hosted deployment, set this to the Neon Postgres connection string.
DATABASE_URL=
RATE_LIMIT_SECRET=

# Resend email API; sender domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TEAM_NOTIFICATION_EMAIL=
RESEND_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API. Scanzaa's owned sender number: +91 8925789321.
# WHATSAPP_PHONE_NUMBER_ID is the ID Meta assigns to that number, not the phone number itself.
# Register an approved template with body variables {{1}} (owner) and {{2}} (restaurant).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Authenticated retry endpoint authorization and consent record version.
CRON_SECRET=
PRIVACY_POLICY_VERSION=v1

# Optional public URL. Set only after Scanzaa publishes its real privacy policy.
VITE_PRIVACY_POLICY_URL=
